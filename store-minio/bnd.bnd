Bundle-Version: ${project.version}
Bundle-SymbolicName: ${project.artifactId}
-metatype: *
-plugin.metatype: com.liferay.ant.bnd.metatype.MetatypePlugin
-plugin.resourcebundle: com.liferay.ant.bnd.resource.bundle.ResourceBundleLoaderAnalyzerPlugin

-includeresource:\
    @minio-*.jar,\
    @okhttp-*.jar,\
    @okio-*.jar,\
    @kotlin-stdlib-*.jar,\
    @annotations-*.jar,\
    @jackson-annotations-*.jar,\
    @jackson-core-*.jar,\
    @jackson-databind-*.jar,\
    @simple-xml-safe-*.jar,\
    @guava-*.jar,\
    @failureaccess-*.jar,\
    @jsr305-*.jar,\
    @checker-qual-*.jar,\
    @error_prone_annotations-*.jar,\
    @j2objc-annotations-*.jar,\
    @bcprov-jdk18on-*.jar,\
    @commons-compress-*.jar,\
    @commons-io-*.jar,\
    @commons-lang3-*.jar,\
    @commons-codec-*.jar,\
    @snappy-java-*.jar

Private-Package:\
    io.minio.*,\
    okhttp3.*,\
    okio.*,\
    kotlin.*,\
    org.jetbrains.annotations.*,\
    com.fasterxml.jackson.*,\
    org.simpleframework.*,\
    com.google.common.*,\
    com.google.thirdparty.*,\
    org.bouncycastle.*,\
    org.apache.commons.compress.*,\
    org.apache.commons.io.*,\
    org.apache.commons.lang3.*,\
    org.apache.commons.codec.*,\
    org.xerial.snappy.*

Import-Package:\
    !android.*,\
    !com.github.luben.zstd,\
    !com.google.appengine.*,\
    !com.google.apphosting.*,\
    !dalvik.system,\
    !org.brotli.*,\
    !org.conscrypt,\
    !org.objectweb.asm,\
    !org.openjsse.*,\
    !org.tukaani.xz,\
    !sun.*,\
    !io.minio.*,\
    !okhttp3.*,\
    !okio.*,\
    !kotlin,\
    !kotlin.*,\
    !kotlinx.*,\
    !org.jetbrains.annotations.*,\
    !com.fasterxml.jackson.*,\
    !org.simpleframework.*,\
    !com.google.common.*,\
    !com.google.thirdparty.*,\
    !org.bouncycastle.*,\
    !org.apache.commons.compress.*,\
    !org.apache.commons.io.*,\
    !org.apache.commons.lang3.*,\
    !org.apache.commons.codec.*,\
    !org.xerial.snappy.*,\
    !org.checkerframework.*,\
    !com.google.errorprone.*,\
    !com.google.j2objc.*,\
    !javax.annotation.*,\
    *
